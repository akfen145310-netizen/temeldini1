rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId 
        && request.resource.data.userId == userId
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.classCode is string && request.resource.data.classCode.size() <= 50;
      allow update: if isOwner(userId) && request.resource.data.userId == userId;
      allow delete: if false;
    }

    // Classrooms Collection
    match /classrooms/{classCode} {
      allow get: if isSignedIn() && isValidId(classCode);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(classCode) 
        && request.resource.data.code == classCode
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(classCode);
      allow delete: if false;
    }

    // User Activities Collection
    match /userActivities/{activityDocId} {
      allow get: if isSignedIn() && isValidId(activityDocId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(activityDocId) 
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(activityDocId) 
        && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow delete: if false;
    }
  }
}
